module mkbin;
// ============================================================================
// xenOS fs embedding tool — freestanding HOST program (no libc/stdlib), raw
// Linux syscalls via host_start.asm. Replicates tools/mkbin.py: turns a flat
// binary into a C3 source file `kernel/src/xk_uprog.c3` (a BSS array filled
// by uprog_init()). Output format is byte-for-byte identical to the Python
// version so the kernel compiles the same way.
// ============================================================================

const int O_RDONLY = 0;
const int O_WRONLY = 1;
const int O_CREAT  = 64;
const int O_TRUNC  = 512;
const long BUF = 0x00040000;        // 256 KiB input staging + output buffer

char[BUF] g_in;
char[BUF] g_out;
long g_olen;

extern fn long lx_syscall(long n, long a, long b, long c, long d);
fn long lx_open(char* p, long fl) { return lx_syscall(2, (long)p, fl, 0, 0); }
fn long lx_read(long fd, char* b, long n) { return lx_syscall(0, fd, (long)b, n, 0); }
fn long lx_write(long fd, char* b, long n){ return lx_syscall(1, fd, (long)b, n, 0); }
fn long lx_close(long fd)         { return lx_syscall(3, fd, 0, 0, 0); }

fn int xk_host_main(int argc, char** argv) @export("xk_host_main")
{
    const char* USAGE = "usage: mkbin <in.bin> <out.c3>\n";
    if (argc != 3) { lx_write(2, (char*)USAGE, 31); return 1; }
    long fd = lx_open(argv[1], O_RDONLY);
    if (fd < 0) { lx_write(2, (char*)"mkbin: cannot open input\n", 26); return 1; }
    long total = 0;
    while (total < BUF)
    {
        long r = lx_read(fd, &g_in[total], BUF - total);
        if (r <= 0) break;
        total += r;
    }
    lx_close(fd);
    if (total == 0) { lx_write(2, (char*)"mkbin: empty input\n", 20); return 1; }

    g_olen = 0;
    append("module xk;\n\n");
    append("// generated by tools/mkbin -- do not edit\n");
    append("const int USER_PROG_LEN = "); append_dec(total); append(";\n");
    append("char["); append_dec(total); append("] user_prog;   // in BSS; filled by uprog_init()\n");
    append("fn void uprog_init()\n{\n");
    for (long i = 0; i < total; i++)
    {
        append("    user_prog["); append_dec(i); append("] = (char)0x");
        append_hex2((uint)g_in[i]); append(";\n");
    }
    append("}\n");

    long out = lx_open(argv[2], O_WRONLY | O_CREAT | O_TRUNC);
    if (out < 0) { lx_write(2, (char*)"mkbin: cannot create output\n", 29); return 1; }
    long w = lx_write(out, &g_out[0], g_olen);
    lx_close(out);
    if (w != g_olen) { lx_write(2, (char*)"mkbin: short write\n", 20); return 1; }
    return 0;
}

fn void append(char* s)
{
    while (*s != 0) { if (g_olen < BUF - 1) g_out[g_olen] = *s; g_olen++; s++; }
}
fn void append_dec(long v)
{
    char[20] tmp;
    long n = 0;
    if (v == 0) { append("0"); return; }
    while (v > 0) { tmp[n] = (char)('0' + (v % 10)); v = v / 10; n++; }
    while (n > 0) { n--; g_out[g_olen] = tmp[n]; g_olen++; }
}
fn void append_hex2(uint b)
{
    g_out[g_olen] = hex_digit((b >> 4) & 0xF); g_olen++;
    g_out[g_olen] = hex_digit(b & 0xF); g_olen++;
}
fn char hex_digit(uint d)
{
    if (d < 10) return (char)('0' + d);
    return (char)('A' + (d - 10));
}